@startuml
top to bottom direction
skinparam nodesep 15
skinparam ranksep 35
skinparam packageStyle rectangle
skinparam linetype polyline

' --- 1. MODÈLES (EN HAUT) ---
package "Modèles (Models)" as PkgModels {
    class ClassModel {
        -$db: PDO
        -$connection: DatabaseConnection
        +__construct($connection: DatabaseConnection)
        +updateTeacherClassCode($teacherId: int, $codeClasse: string): bool
        +getStudentsByTeacher($teacherId: int): array
        +createStudent($teacherId: int, $pseudos: string, $password: string, $codeClasse: string): bool
    }
    class DeleteModel {
        -$connection: DatabaseConnection
        +__construct($connection: DatabaseConnection)
        +getDelete($_login: string, $password: string): ?bool
    }
    class ForgotPasswordModel {
        -$connection: DatabaseConnection
        +__construct($connection: DatabaseConnection)
        +saveTokenInDatabase($email: string, $token: string): bool
        +verifyTokenAndChangePassword($token: string, $newPassword: string): bool
    }
    class LoginModel {
        -$connection: DatabaseConnection
        +__construct($connection: DatabaseConnection)
        +getConnection($_login: string, $_password: string): ?object
    }
    class SignupModel {
        -$connection: DatabaseConnection
        +__construct($connection: DatabaseConnection)
        +getSignup($_login: string, $_password: string, $_isTeacher: bool): bool
        +getUserByEmail($email: string): ?array
    }
}

