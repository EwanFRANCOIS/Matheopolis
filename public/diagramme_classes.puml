' --- 3. VUES (EN BAS) ---
package "Vues (Views)" as PkgViews {
    class AccountView {
        +show(): string
    }
    class ActivityView {
        +show($result: string|float|null): string
    }
    class BookView {
        +show(): string
    }
    class DeleteView {
        +show($error: ?string): string
    }
    class ErrorView {
        -$message: string
        +show(): string
    }
    class ForgotPasswordView {
        +show(...): string
    }
    class HomepageView {
        +show(): string
    }
    class LoginView {
        +show($error: ?string): string
    }
    class ProfileView {
        +show(...): string
    }
    class SignupView {
        +show($error: ?string): string
    }
    class StoryView {
        +show($activites: array): string
    }
    class WorldView {
        +show(...): string
    }
}

' --- CONTRAINTES D'ALIGNEMENT DES COUCHES MVC ---
PkgModels -[hidden]down-> PkgControllers
PkgControllers -[hidden]down-> PkgViews

' --- NOYAU & CONFIGURATION ---
package "Core / Entrée" {
    class Index <<Entry Point>> {}
    class Autoloader {
        +register(): void
    }
    class Env {
        +charger($chemin: string): void
        +get($cle: string, $defaut: ?string): ?string
    }
    class DatabaseConnection {
        -$connection: ?PDO
        -$instance: ?DatabaseConnection
        -__construct()
        +{static} getInstance(): DatabaseConnection
        +getConnection(): PDO
    }
    class Request {
        +$method: string
        +$path: string
        +$get: array
        +$post: array
        +$headers: array
        +__construct(...)
        +{static} fromGlobals(): self
        +get($key: string, $default)
        +post($key: string, $default)
        +setSession($key: string, $value: mixed): void
        +destroySession(): void
    }
    class Response {
        -$content: string
        -$statusCode: int
        -$headers: array
        +__construct($content: string, $statusCode: int, $headers: array)
        +{static} redirect($url: string): self
        +send(): void
    }
    class Router {
        -$routes: array
        -$factories: array
        +__construct($routes: array, $factories: array)
        +dispatch($request: Request): Response
    }
    class View {
        -$userEmail: ?string
        +__construct($userEmail: ?string)
        +render($title: string, $content: string, $status: int): Response
    }
    class Layout {
        -$title: string
        -$content: string
        -$userEmail: ?string
        +__construct($title: string, $content: string, $userEmail: ?string)
        +show($status: int): Response
    }
}

